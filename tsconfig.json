{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "target": "ES2022",
    "types": ["chrome"]
  },
  "include": ["src/**/*.js", "src/**/*.d.ts"],
  "exclude": ["src/content/cedict-data.js"]
}
